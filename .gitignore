# ==============================================================================
# GenAI Stack .gitignore
# ==============================================================================

# Environment files (contain secrets)
.env
.env.local
.env.*.local

# Local compose overrides
docker-compose.override.yml

# Docker volumes (if mounted locally)
data/

# Edge inference model binaries (provided at deploy time — NEVER commit)
edge-impulse/models/*.eim
edge-impulse/models/*.eim.bak
edge-impulse/models/*.zip
onnx/models/*.onnx
onnx/models/*.onnx.bak

# Ollama models (large binary files — pulled at runtime)
ollama/models/

# n8n user data
n8n/.n8n/
n8n/database.sqlite

# Letta agent data
letta/data/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Python bytecode (the runner and System 1 tests)
__pycache__/
*.py[cod]
.pytest_cache/

# Logs
*.log
logs/

# Temporary files
tmp/
temp/
*.tmp

# SEDA agents
.agents/

# System 1 fine-tuning output (make system1-train): corpus and checkpoint
system1/train/out/
