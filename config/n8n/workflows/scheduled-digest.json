{
  "id": "p4n4ScheduledDigest",
  "name": "Scheduled Telemetry Digest",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "id": "a1b2c3d4-0002-0002-0002-000000000001",
      "name": "Hourly Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "keepOnlySet": true,
        "values": {
          "string": [
            {
              "name": "org",
              "value": "ming"
            },
            {
              "name": "bucket",
              "value": "raw_telemetry"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0002-0002-0002-000000000005",
      "name": "Settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [460, 300],
      "notes": "INFLUXDB_ORG and INFLUXDB_BUCKET from the project's .env"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://p4n4-influxdb:8086/api/v2/query?org={{ encodeURIComponent($json.org) }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/csv"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "query",
              "value": "=from(bucket: \"{{ $json.bucket }}\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r._measurement == \"sensor_data\" and r._field == \"value\")\n  |> group(columns: [\"device\", \"sensor\"])\n  |> mean()"
            },
            {
              "name": "type",
              "value": "flux"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0002-0002-0002-000000000002",
      "name": "Query InfluxDB",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "2",
          "name": "p4n4 InfluxDB"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://p4n4-ollama:11434/api/generate",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "llama3.2"
            },
            {
              "name": "prompt",
              "value": "=Summarize the following IoT telemetry data from the last hour in 2-3 sentences. Highlight any anomalies or notable trends:\n\n{{ $json.data }}"
            },
            {
              "name": "stream",
              "value": false
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0002-0002-0002-000000000003",
      "name": "Generate Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "digest",
              "value": "={{ $json.response }}"
            },
            {
              "name": "generated_at",
              "value": "={{ $now.toISO() }}"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0002-0002-0002-000000000004",
      "name": "Format Digest",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [1120, 300]
    }
  ],
  "pinData": {},
  "connections": {
    "Hourly Trigger": {
      "main": [
        [
          {
            "node": "Settings",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Settings": {
      "main": [
        [
          {
            "node": "Query InfluxDB",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Query InfluxDB": {
      "main": [
        [
          {
            "node": "Generate Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Summary": {
      "main": [
        [
          {
            "node": "Format Digest",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "9aeb4b98-ac07-527e-a5f1-05b1033afb17",
  "tags": [
    {"id": "p4n4tag-p4n4", "name": "p4n4"},
    {"id": "p4n4tag-ollama", "name": "ollama"},
    {"id": "p4n4tag-influxdb", "name": "influxdb"},
    {"id": "p4n4tag-scheduled", "name": "scheduled"}
  ]
}
