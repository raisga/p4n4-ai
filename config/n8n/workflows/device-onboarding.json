    },
    {
      "parameters": {
        "jsCode": "// The trigger parses the JSON body: { topic, message }\nconst { topic = '', message } = $input.first().json;\nconst payload = message && typeof message === 'object' ? message : {};\nconst device = topic.split('/')[1] || 'unknown';\n\nreturn [\n  {\n    json: {\n      device,\n      device_type: payload.type || 'generic',\n      firmware: payload.firmware || 'unknown',\n      location: payload.location || 'unset',\n      registered_at: new Date().toISOString(),\n      status: 'active',\n    },\n  },\n];"
      },
      "id": "a1b2c3d4-0003-0003-0003-000000000002",
      "name": "Parse Device Info",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "topic": "=devices/{{ $json.device }}/status",
        "message": "={{ JSON.stringify({ status: 'registered', device: $json.device, registered_at: $json.registered_at }) }}",
        "sendInputData": false,
        "options": {}
      },
      "id": "a1b2c3d4-0003-0003-0003-000000000003",
      "name": "Publish Confirmation",
