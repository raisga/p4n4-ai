# ==============================================================================
# GenAI Stack Environment Configuration
# ==============================================================================
# Copy this file to .env and customize as needed:
#   cp .env.example .env
# IMPORTANT: Change all default passwords and keys before production use!
# ==============================================================================

# ------------------------------------------------------------------------------
# Services
# ------------------------------------------------------------------------------
# Services to run, comma-separated. Every service is optional; the default is
# Ollama alone.
#   Available: ollama, letta, n8n, system1 (fast typed decisions: see below)
COMPOSE_PROFILES=ollama

# Restart policy for every container: unless-stopped brings them back after a
# reboot or a Docker restart; "no" leaves them down until the next `p4n4 up`
# (also: always, on-failure). Apply a change with `p4n4 up`.
RESTART_POLICY=unless-stopped

# ------------------------------------------------------------------------------
# Ollama
# ------------------------------------------------------------------------------
# Host port for the Ollama API. Change it when Ollama already runs on the host
# (it listens on 11434 too); containers still reach it at p4n4-ollama:11434.
OLLAMA_PORT=11434
# Address the Ollama API is published on. It has no authentication: keep
# 127.0.0.1 unless the network is trusted.
OLLAMA_BIND=127.0.0.1
# Models kept in memory, and requests served, at once (raise them on hosts with
# memory or a GPU to spare)
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1

# ------------------------------------------------------------------------------
# Letta
# ------------------------------------------------------------------------------
# Clients send it as "Authorization: Bearer <password>"
LETTA_SERVER_PASSWORD=lettapassword
# Address the Letta API is published on
LETTA_BIND=127.0.0.1

# ------------------------------------------------------------------------------
# n8n
# ------------------------------------------------------------------------------
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=adminpassword

# Encryption key for stored credentials — must be 32+ characters
N8N_ENCRYPTION_KEY=change-me-32-char-encryption-key

# Hostname used for webhook URLs (set to your server's IP/domain in production)
N8N_HOST=localhost

# ------------------------------------------------------------------------------
# System 1 (laya): fast typed decisions, advisory only. Starts when COMPOSE_PROFILES
# lists system1; `p4n4 ai system1 enable` adds it, sets the key and pulls the model.
# ------------------------------------------------------------------------------
# Bearer token for callers (n8n, Node-RED): 32+ characters. Empty: the service
# refuses to start
SYSTEM1_API_KEY=
SYSTEM1_IMAGE=ghcr.io/raisga/p4n4-system1:0.1.0
# Model commit on huggingface.co/convaiinnovations/laya: a 40-character sha, never a
# branch. The image refuses a revision whose file hashes it doesn't pin.
SYSTEM1_REVISION=aa8c91ca088ec597df95a0d1c76b3063cb2ae5e8
# multilingual (default) or english
SYSTEM1_CHECKPOINT=multilingual
# torch threads for inference (the container is limited to 2 CPUs)
SYSTEM1_THREADS=2
# Bearer token channel adapters (Telegram, WhatsApp, a web chat) send to n8n's
# operator-intake webhook. Stored in n8n's "p4n4 Operator Intake" credential, which
# `p4n4 ai system1 enable` and `p4n4 secret rotate` keep in step
OPERATOR_INTAKE_TOKEN=

# ------------------------------------------------------------------------------
# InfluxDB (shared with p4n4-iot — must match values in p4n4-iot .env)
# ------------------------------------------------------------------------------
INFLUXDB_TOKEN=p4n4-stack-token
INFLUXDB_ORG=ming
INFLUXDB_BUCKET=raw_telemetry

# ------------------------------------------------------------------------------
# General
# ------------------------------------------------------------------------------
# Timezone for n8n's schedules and date expressions
TZ=UTC
