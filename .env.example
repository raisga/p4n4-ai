# ==============================================================================
# GenAI Stack Environment Configuration
# ==============================================================================
# Copy this file to .env and customize as needed:
#   cp .env.example .env
# IMPORTANT: Change all default passwords and keys before production use!
# ==============================================================================

# ------------------------------------------------------------------------------
# Services
# ------------------------------------------------------------------------------
# Services to run, comma-separated. Every service is optional; the default is
# Ollama alone.
#   Available: ollama, letta, n8n, system1 (fast typed decisions: see below),
#              ei-runner (edge inference: Edge Impulse or ONNX model, see below)
COMPOSE_PROFILES=ollama

# Restart policy for every container: unless-stopped brings them back after a
# reboot or a Docker restart; "no" leaves them down until the next `p4n4 up`
# (also: always, on-failure). Apply a change with `p4n4 up`.
RESTART_POLICY=unless-stopped

# ------------------------------------------------------------------------------
# Ollama
# ------------------------------------------------------------------------------
# Host port for the Ollama API. Change it when Ollama already runs on the host
# (it listens on 11434 too); containers still reach it at p4n4-ollama:11434.
OLLAMA_PORT=11434
# Address the Ollama API is published on. It has no authentication: keep
# 127.0.0.1 unless the network is trusted.
OLLAMA_BIND=127.0.0.1
# Models kept in memory, and requests served, at once (raise them on hosts with
# memory or a GPU to spare)
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1

# ------------------------------------------------------------------------------
# Letta
# ------------------------------------------------------------------------------
# Clients send it as "Authorization: Bearer <password>"
LETTA_SERVER_PASSWORD=lettapassword
# Address the Letta API is published on
LETTA_BIND=127.0.0.1

# ------------------------------------------------------------------------------
# n8n
# ------------------------------------------------------------------------------
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=adminpassword

# Encryption key for stored credentials — must be 32+ characters
N8N_ENCRYPTION_KEY=change-me-32-char-encryption-key

# Hostname used for webhook URLs (set to your server's IP/domain in production)
N8N_HOST=localhost

# ------------------------------------------------------------------------------
# System 1 (laya): fast typed decisions, advisory only. Starts when COMPOSE_PROFILES
# lists system1; `p4n4 ai system1 enable` adds it, sets the key and pulls the model.
# ------------------------------------------------------------------------------
# Bearer token for callers (n8n, Node-RED): 32+ characters. Empty: the service
# refuses to start
SYSTEM1_API_KEY=
SYSTEM1_IMAGE=ghcr.io/raisga/p4n4-system1:0.1.0
# Model repository on huggingface.co: the base checkpoints, or a fine-tuned one in a
# repository p4n4 controls (decisions/system1.md §17). The image pins both.
SYSTEM1_REPO=convaiinnovations/laya
# Model commit in SYSTEM1_REPO: a 40-character sha, never a branch. The image refuses a
# revision whose file hashes it doesn't pin.
SYSTEM1_REVISION=aa8c91ca088ec597df95a0d1c76b3063cb2ae5e8
# multilingual (default) or english
SYSTEM1_CHECKPOINT=multilingual
# torch threads for inference (the container is limited to 2 CPUs)
SYSTEM1_THREADS=2
# Site calibration: temperatures per laya bucket, a file in config/system1/calibration/
# (`p4n4 ai system1 eval --fit-calibration --save-calibration` writes it). Empty: none.
# Changing it changes every set's confidences: evaluate every set again, bump its version.
SYSTEM1_CALIBRATION=
# Bearer token channel adapters (Telegram, WhatsApp, a web chat) send to n8n's
# operator-intake webhook. Stored in n8n's "p4n4 Operator Intake" credential, which
# `p4n4 ai system1 enable` and `p4n4 secret rotate` keep in step
OPERATOR_INTAKE_TOKEN=
# Bearer token Grafana's System 1 drift alerts send to n8n's system1-drift webhook: the
# same value as SYSTEM1_ALERT_TOKEN in the iot stack's .env. Stored in n8n's
# "p4n4 System 1 Alerts" credential, which `p4n4 ai system1 enable` keeps in step
SYSTEM1_ALERT_TOKEN=

# ------------------------------------------------------------------------------
# Edge inference runner (ei-runner): starts when COMPOSE_PROFILES lists ei-runner
# ------------------------------------------------------------------------------

# Which inference backend to load:
#   auto  - Edge Impulse .eim if present, else ONNX .onnx, else mock (default)
#   eim   - Edge Impulse only
#   onnx  - ONNX Runtime only
#   mock  - simulated inference (no model)
# A model that is selected or present but doesn't load stops the runner (see
# `docker logs p4n4-ei-runner`), rather than publishing mock results as real.
MODEL_BACKEND=auto

# Most values one sample may carry; larger samples are rejected
MAX_FEATURES=65536

# Address the runner's HTTP API (port 8080) is published on. It has no
# authentication: keep 127.0.0.1 unless the network is trusted.
EI_RUNNER_BIND=127.0.0.1

# API key for Edge Impulse cloud features (optional — only needed for cloud sync)
# Get your key at: https://studio.edgeimpulse.com → project → Dashboard → Keys
EI_API_KEY=

# Filename of the .eim model to run (place the file in edge-impulse/models/)
# Download from Edge Impulse Studio: Deployment → Linux (AARCH64 or x86_64)
EI_MODEL_FILE=model.eim

# Filename of the .onnx model to run (place the file in onnx/models/)
ONNX_MODEL_FILE=model.onnx

# Comma-separated class labels matching the model's output order (optional).
# Unnamed outputs fall back to class_0, class_1, ...
# Example: ONNX_LABELS=idle,running,anomaly,vibration
ONNX_LABELS=

# MQTT broker (shared with p4n4-iot — must match values in p4n4-iot .env).
# Use 'p4n4-mqtt' when running alongside p4n4-iot on p4n4-net
MQTT_HOST=p4n4-mqtt
MQTT_PORT=1883

# Credentials — leave blank if Mosquitto runs without authentication
MQTT_USER=
MQTT_PASSWORD=

# Topics. Input follows sensors/<device-id>/<measurement>; + matches any device.
# Results go to inference/<device-id>/result; {device} is replaced by the device id.
MQTT_TOPIC_INPUT=sensors/+/raw
MQTT_TOPIC_RESULTS=inference/{device}/result

# ------------------------------------------------------------------------------
# InfluxDB (shared with p4n4-iot — must match values in p4n4-iot .env)
# ------------------------------------------------------------------------------
INFLUXDB_TOKEN=p4n4-stack-token
INFLUXDB_ORG=ming
# n8n's starter workflows read sensor data from here
INFLUXDB_BUCKET=raw_telemetry
# The edge inference runner writes its results here
INFLUXDB_BUCKET_AI_EVENTS=ai_events

# ------------------------------------------------------------------------------
# General
# ------------------------------------------------------------------------------
# Timezone for n8n's schedules and date expressions, and the runner's logs
TZ=UTC
